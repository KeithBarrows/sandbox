{
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Sinks.Seq"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Npgsql": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"],
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "E:\\Logs\\Serilog\\app\\weatherstation-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 31,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext}{NewLine}{Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "Urls": "http://0.0.0.0:5068",
  "ConnectionStrings": {
    "WeatherDb": "Host=127.0.0.1;Port=54322;Database=postgres;Username=postgres;Password=postgres"
  },
  "Locations": [
    {
      "Key": "citra",
      "DisplayName": "Citra, FL",
      "Latitude": 29.41192,
      "Longitude": -82.10982,
      "TimeZone": "America/New_York",
      "IsPrimary": true
    },
    {
      "Key": "frederick",
      "DisplayName": "Frederick, CO",
      "Latitude": 40.1003,
      "Longitude": -105.0339,
      "TimeZone": "America/Denver",
      "IsPrimary": false
    }
  ],
  "Collector": {
    "PollIntervalMinutes": 15,
    "BackfillDays": 365
  }
}
